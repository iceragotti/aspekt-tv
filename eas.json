{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "aspekt-next-development",
      "env": {
        "EXPO_PUBLIC_VIDEO_STAGING": "false",
        "EXPO_PUBLIC_TRUST_STAGING": "false"
      }
    },
    "beta-preview": {
      "distribution": "internal",
      "channel": "aspekt-next-beta",
      "env": {
        "EXPO_PUBLIC_VIDEO_STAGING": "false",
        "EXPO_PUBLIC_TRUST_STAGING": "false"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    }
  }
}
