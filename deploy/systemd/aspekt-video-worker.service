[Unit]
Description=ASPEKT Video Processing Worker (isolated local staging ONLY)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aspekt-video
Group=aspekt-video
WorkingDirectory=/srv/aspekt-tv
EnvironmentFile=/etc/aspekt-video/worker.env
ExecStart=/usr/bin/node /srv/aspekt-tv/scripts/video-worker.mjs --daemon
Restart=always
RestartSec=15
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=768M
CPUQuota=200%
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
